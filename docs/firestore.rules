rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.code is string && request.resource.data.code.size() < 20000;
    }
    match /fids/{fid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    match /battles/{id} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string && request.resource.data.to != request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.to == request.auth.uid;
    }
    match /mail/{id} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string && request.resource.data.to != request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.to == request.auth.uid;
    }
    match /rooms/{id} {
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow read, update: if request.auth != null && (resource.data.host == request.auth.uid || resource.data.guest == request.auth.uid);
    }
    match /news/{id} {
      allow read: if request.auth != null;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.code is string && request.resource.data.code.size() < 20000;
      // 版672：データ引き継ぎで、前の端末のランキングの記録を、新しい端末から消せる（引き継ぎコードを知っている人だけ）
      allow delete: if request.auth != null && resource.data.sv is string
                    && get(/databases/$(database)/documents/saves/$(resource.data.sv)).data.cur == request.auth.uid;
    }
    match /fids/{fid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // 版672：持ち主が引き継ぎコードを結ぶ・引き継いだ新しい端末がフレンドIDを受け取る
      allow update: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && (resource.data.uid == request.auth.uid
                        || (request.resource.data.sv is string
                            && get(/databases/$(database)/documents/saves/$(request.resource.data.sv)).data.cur == request.auth.uid
                            && get(/databases/$(database)/documents/saves/$(request.resource.data.sv)).data.fid == fid));
    }
    // 版672：データ引き継ぎ（クラウドのセーブ）。引き継ぎコードを知っている人だけが読める・書ける（一覧は見られない）
    match /saves/{code} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && code.size() == 12
                            && request.resource.data.cur == request.auth.uid
                            && request.resource.data.d is string && request.resource.data.d.size() < 900000;
    }
    match /battles/{id} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string && request.resource.data.to != request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.to == request.auth.uid;
    }
    match /mail/{id} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string && request.resource.data.to != request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.to == request.auth.uid;
    }
    match /rooms/{id} {
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow read, update: if request.auth != null && (resource.data.host == request.auth.uid || resource.data.guest == request.auth.uid);
    }
    match /news/{id} {
      allow read: if request.auth != null;
    }
  }
}
